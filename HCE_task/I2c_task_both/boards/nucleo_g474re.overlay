#include <zephyr/dt-bindings/i2c/i2c.h>

/*
 * I2C1 on the Arduino header: SCL=PB8, SDA=PB9.
 * Standard-mode (100 kHz) I2C, matching the previous SPI project's
 * 1 MHz-class polling cadence but at typical I2C bus speed.
 */
&i2c1 {
	pinctrl-0 = <&i2c1_scl_pb8 &i2c1_sda_pb9>;
	pinctrl-names = "default";
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};
