/*
 * Motor Direction Reversal Under Load - board overlay (NUCLEO-G474RE)
 *
 * Pin map:
 *   IR2104 #1 PWM (pin2)            -> PC0  (TIM1_CH1)
 *   IR2104 #1 SD  (pin3, shutdown)  -> PC1  (plain GPIO, ACTIVE_LOW = enabled)
 *   IR2104 #2 PWM (pin2)            -> PC2  (TIM1_CH3)
 *   IR2104 #2 SD  (pin3, shutdown)  -> PC3  (plain GPIO, ACTIVE_LOW = enabled)
 *   Current sensor (ACS712)         -> PA0  (ADC1_IN1)
 *   Voltage sensor (0-25V module)   -> PA4  (ADC2_IN17)
 *   Motor direction FWD indicator   -> PB13 (plain GPIO, ACTIVE_HIGH)
 *   Motor direction REV indicator   -> PB15 (plain GPIO, ACTIVE_HIGH)
 *   LCD 16x2 (PCF8574 I2C backpack) -> I2C2 (PA9 SCL / PA8 SDA), addr 0x27
 *   User button                     -> onboard B1, board default "sw0" (PC13)
 *
 * NOTE: SD1/SD2 keep the same physical pins (PC1/PC3) that were previously
 * declared as extra TIM1 PWM channels; they are now plain digital outputs
 * since the IR2104 SHUTDOWN pin is a simple enable/disable line, not PWM.
 */

&i2c2 {
	status = "okay";
	pinctrl-0 = <&i2c2_scl_pa9 &i2c2_sda_pa8>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;

	lcd_pcf8574: pcf8574@27 {
		compatible = "i2c-device";
		reg = <0x27>;
		label = "LCD_PCF8574";
	};
};

&timers1 {
	status = "okay";

	ir2104_pwm_tim1: pwm {
		status = "okay";
		pinctrl-0 = <&tim1_ch1_pc0 &tim1_ch3_pc2>;
		pinctrl-names = "default";
	};
};

&adc1 {
	status = "okay";
	pinctrl-0 = <&adc1_in1_pa0>;
	pinctrl-names = "default";
	st,adc-clock-source = <SYNC>;
	st,adc-prescaler = <4>;
};

&adc2 {
	status = "okay";
	pinctrl-0 = <&adc2_in17_pa4>;
	pinctrl-names = "default";
	st,adc-clock-source = <SYNC>;
	st,adc-prescaler = <4>;
};

&gpiob {
	status = "okay";
};

&gpioc {
	status = "okay";
};

/ {
	ir2104_shutdown_pins {
		compatible = "gpio-leds";

		sd1: sd1 {
			gpios = <&gpioc 1 GPIO_ACTIVE_HIGH>;
			label = "IR2104_1_SD";
		};

		sd2: sd2 {
			gpios = <&gpioc 3 GPIO_ACTIVE_HIGH>;
			label = "IR2104_2_SD";
		};
	};

	motor_dir_pins {
		compatible = "gpio-leds";

		dir_fwd: dir_fwd {
			gpios = <&gpiob 13 GPIO_ACTIVE_HIGH>;
			label = "MOTOR_DIR_FWD";
		};

		dir_rev: dir_rev {
			gpios = <&gpiob 15 GPIO_ACTIVE_HIGH>;
			label = "MOTOR_DIR_REV";
		};
	};

	aliases {
		ir2104pwm = &ir2104_pwm_tim1;
		sd1 = &sd1;
		sd2 = &sd2;
		dirfwd = &dir_fwd;
		dirrev = &dir_rev;
		lcddisplay = &lcd_pcf8574;
		currentsensor = &adc1;
		voltagesensor = &adc2;
	};
};
